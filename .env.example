# Add keys locally to .env. The application never writes keys into campaign files.
GEMINI_API_KEY=
TAVILY_API_KEY=
COVERR_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional local transcription executable and model; no automatic paid fallback.
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
# Optional LOCAL ComfyUI with a tested exported API workflow (model weights installed separately).
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=workflows/ltx-2b-gguf-i2v.json
# Explicit execution type. --lowvram/offloading is still CUDA, not CPU-only.
COMFY_DEVICE=cuda
# Register real standalone probe reports first; no fabricated profile is shipped.
COMFY_PROFILE=
COMFY_POLL_TIMEOUT_SECONDS=1800
# Server defaults for NEW campaigns. Existing campaign edits preserve saved settings.
# JSON limits merge with the backend defaults. Zero blocks metered resources.
CFC_PLANNING_MODEL=gemini-2.5-flash
CFC_DEFAULT_LIMITS_JSON={}
# To enable a finite allowance for NEW AI campaigns, configure e.g. {"generation_jobs":15}.
# Existing campaigns keep saved limits; adopting a higher server allowance needs a new plan review.
CFC_DEFAULT_USAGE_RATES_JSON={}
