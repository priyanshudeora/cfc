# Add keys locally to .env. The application never writes keys into campaign files.
GEMINI_API_KEY=
TAVILY_API_KEY=
COVERR_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional local transcription executable and model; no automatic paid fallback.
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
# Optional LOCAL ComfyUI with a tested exported API workflow (model weights installed separately).
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=
COMFY_MIN_VRAM_GB=10
